{
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 1024
    },
    "disable-model-invocation": {
      "const": false
    },
    "disable_model_invocation": {
      "const": false
    }
  }
}
